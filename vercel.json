{
  "rewrites": [
    {
      "source": "/opensky-api/:path*",
      "destination": "/api/opensky-api/:path*"
    },
    {
      "source": "/opensky-auth/:path*",
      "destination": "/api/opensky-auth/:path*"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
