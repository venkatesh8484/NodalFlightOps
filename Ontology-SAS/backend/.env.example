# Databricks AI Gateway settings (required)
DATABRICKS_HOST=https://your-databricks-workspace.cloud.databricks.com/
DATABRICKS_TOKEN=your_databricks_token
DATABRICKS_MODEL=databricks-gpt-5-4-mini

# SSL behavior for Databricks calls.
# Use false in corp-network/dev setups with TLS interception.
# Use true in production with trusted certificates.
DATABRICKS_VERIFY_SSL=false

# Optional app defaults
# OUTPUT_BASE=company_taxonomy
# API_PORT=8000
