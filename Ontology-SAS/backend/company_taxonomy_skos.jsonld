                {
                    "@language": "en",
                    "@value": "safety recommendations"
                }
            ],
            "skos:scopeNote": {
                "@language": "en",
                "@value": "A set of non-mandatory guidelines or procedures advised for adoption to ensure safety, consistency, and operational efficiency within an industry. These represent recognized methods for achieving specific outcomes based on established professional consensus."
